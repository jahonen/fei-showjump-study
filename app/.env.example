# Firebase web app config (public client values)
# Get these values from the Firebase console: Project Settings > General > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=showjump-study.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=showjump-study
VITE_FIREBASE_STORAGE_BUCKET=showjump-study.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=409268557167
VITE_FIREBASE_APP_ID=

# Used only by the Node ingestion script; not exposed to the client.
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
FIREBASE_PROJECT_ID=showjump-study
